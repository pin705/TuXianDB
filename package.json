{
  "name": "tuxiandb",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/db.ts seed",
    "pipeline:ingest": "node --env-file-if-exists=.env scripts/pipeline/ingest.ts",
    "pipeline:extract": "node --env-file-if-exists=.env scripts/pipeline/extract.ts",
    "pipeline:build": "node --env-file-if-exists=.env scripts/pipeline/build.ts",
    "pipeline:eval": "node --env-file-if-exists=.env scripts/pipeline/eval.ts",
    "test:db": "node --env-file-if-exists=.env --test test/pipeline.int.ts",
    "pipeline:portraits": "node --env-file-if-exists=.env scripts/pipeline/portraits.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "next": "^16.3.7",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
