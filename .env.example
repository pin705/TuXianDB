# Postgres. Local: `npm run db:up` then this URL. Production: pooled URL from your provider (Neon, Supabase…).
DATABASE_URL=postgres://tuxian:tuxian@127.0.0.1:5433/tuxian

# Public origin, used for canonical URLs, sitemap and robots.
SITE_URL=http://localhost:3000

# /admin basic auth. Admin is locked when ADMIN_PASSWORD is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Salt for hashing reporter IPs (rate limiting without storing raw IPs).
REPORT_SALT=change-me

# Pipeline only (never needed by the web app).
ANTHROPIC_API_KEY=
PIPELINE_MODEL=claude-opus-5-5
PIPELINE_EFFORT=medium
CONTACT_EMAIL=
# AI portraits only (pipeline:portraits). Claude does not generate images.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-flare
